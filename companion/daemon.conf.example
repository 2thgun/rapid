# raPId unified companion configuration for ACC, AC, ACE, and iRacing.
pi_host=192.168.1.64
pi_port=9001
sample_rate=50
protocol=v4
# New customer installations pair through the companion. The launcher supplies
# the resulting per-user DPAPI blob as --auth-key-dpapi-file; environment
# variables are not expanded here. A plaintext telemetry.key is an upgrade-only
# compatibility fallback for existing prepared demo kits and must not be created
# for a newly paired Windows account.
output_directory=recordings
local_recording=true
no_forward=false
