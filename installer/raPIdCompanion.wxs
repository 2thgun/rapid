<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="raPId Companion" Manufacturer="raPId" Version="1.0.0" UpgradeCode="A62B2831-CA89-4F7D-8A71-4B0B6046E361" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of raPId Companion is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="raPId">
        <Component Id="CompanionFiles" Guid="A3746BD0-5F44-49F4-B11E-6FA9A84DD62D">
          <File Id="CompanionExe" Source="$(var.CompanionExe)" KeyPath="yes" />
          <File Id="CompanionLauncher" Source="$(var.CompanionLauncher)" />
          <File Id="PairLauncher" Source="$(var.PairLauncher)" />
          <File Id="ConfigExample" Source="$(var.ConfigExample)" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="raPId" />
    </StandardDirectory>
    <!-- #49: the MSI bundles PAIR.cmd but had no Start-menu entry point. Shortcut
         both the portable exe (pairs on first run) and the manual pairing
         launcher so neither needs a terminal or a remembered command line. -->
    <Component Id="StartMenuShortcuts" Directory="ProgramMenuDir" Guid="B7F1C0D2-6E3A-4C8B-9F10-2D4E6A8C0B12">
      <Shortcut Id="CompanionShortcut" Name="raPId Companion"
                Description="Run the raPId telemetry companion (pairs on first use)"
                Target="[INSTALLFOLDER]rapid-telemetry-daemon.exe" WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="PairShortcut" Name="Pair raPId Companion with the Pi"
                Description="Manually pair this Windows account with the raPId Pi"
                Target="[INSTALLFOLDER]PAIR.cmd" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\raPId\Companion" Name="startMenuShortcuts"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Feature Id="MainFeature" Title="raPId Companion" Level="1">
      <ComponentRef Id="CompanionFiles" />
      <ComponentRef Id="StartMenuShortcuts" />
    </Feature>
  </Package>
</Wix>
