#!/bin/sh
set -eu

runtime=/run/rapid-network
request="$runtime/request"
state="$runtime/state"
ap_connection=rapid-demo

home_connection() {
  # A deployed Pi can pin its intended home profile in the root-owned
  # EnvironmentFile. Falling back to the first saved profile preserves the
  # generic first-boot behavior for a newly provisioned device.
  if [ -n "${RAPID_HOME_CONNECTION:-}" ]; then
    printf '%s\n' "$RAPID_HOME_CONNECTION"
    return
  fi
  nmcli -t -f NAME,TYPE connection show | awk -F: \
    '$2 == "802-11-wireless" && $1 != "rapid-demo" { print $1; exit }'
}

write_state() {
  printf '{"mode":"%s","updated_at":"%s"}\n' "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$state"
  chmod 0640 "$state"
}

apply_mode() {
  mode=$1
  case "$mode" in
    ap) target=$ap_connection ;;
    home) target=$(home_connection) ;;
    off)
      nmcli radio wifi off
      write_state off
      return
      ;;
    *) return 1 ;;
  esac
  [ -n "$target" ]
  nmcli radio wifi on
  nmcli connection up "$target" ifname wlan0
  write_state "$mode"
}

# A boot always resumes the intended Home connection. AP remains the fallback
# configured through NetworkManager priorities; Off is an explicit live choice.
if ! apply_mode home; then
  active=$(nmcli -g GENERAL.CONNECTION device show wlan0 2>/dev/null || true)
  [ "$active" = "$ap_connection" ] && write_state ap || write_state unknown
fi

while :; do
  if [ -f "$request" ]; then
    mode=$(sed -n 's/.*"mode"[[:space:]]*:[[:space:]]*"\(off\|ap\|home\)".*/\1/p' "$request" | head -n 1)
    rm -f "$request"
    if [ -n "$mode" ]; then
      if ! apply_mode "$mode"; then
        write_state error
      fi
    fi
  fi
  sleep 1
done
