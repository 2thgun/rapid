[Unit]
Description=raPId native telemetry dashboard and recorder
After=network.target

[Service]
Type=simple
User=rapid
StandardOutput=journal
StandardError=journal
WorkingDirectory=/home/rapid/raPId
Environment=RAPID_CONFIG=/home/rapid/raPId/config.toml
ExecStart=/home/rapid/raPId/cpp/build/rapid-pi
TimeoutStopSec=90
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
