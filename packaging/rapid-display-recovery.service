[Unit]
Description=raPId display preview recovery
# #41: /var/lib/rapid is created by rapid.service (StateDirectory=rapid,
# rapid:rapid 0700). ReadWritePaths=/var/lib/rapid requires the path to exist
# before this unit's mount namespace, so order after rapid.service; do NOT add
# StateDirectory=rapid here, which would re-own the directory to root and lock
# out rapid.service.
Requires=rapid.service
After=rapid.service
After=rapid-display.service graphical.target

[Service]
Type=oneshot
User=root
Environment=DISPLAY=:0
ExecStart=/usr/lib/rapid/rapid-display-recovery --state-file /var/lib/rapid/display-recovery.json --recover
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
# ProtectSystem=strict makes /var read-only; --recover always rewrites its
# rotation state file there (rapid.service's StateDirectory) (#25).
ReadWritePaths=/var/lib/rapid

[Install]
WantedBy=graphical.target
