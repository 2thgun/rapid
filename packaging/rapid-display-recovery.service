[Unit]
Description=raPId display preview recovery
After=rapid-display.service graphical.target

[Service]
Type=oneshot
User=root
Environment=DISPLAY=:0
ExecStart=/usr/lib/rapid/rapid-display-recovery --state-file /var/lib/rapid/display-recovery.json --recover
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=graphical.target
