[Unit]
Description=raPId telemetry runtime
Requires=rapid-firstboot.service rapid-provision.service
After=network.target rapid-firstboot.service rapid-provision.service

[Service]
Type=simple
User=rapid
Group=rapid
StateDirectory=rapid
StateDirectoryMode=0700
WorkingDirectory=/var/lib/rapid
Environment=RAPID_CONFIG=/etc/rapid/config.toml
EnvironmentFile=-/etc/rapid/runtime.env
ExecStart=/usr/lib/rapid/rapid-pi
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
