#!/bin/sh
set -eu

runtime=/run/rapid-network
request="$runtime/request"
state="$runtime/state"
ap_connection=${RAPID_AP_CONNECTION:-rapid-setup}

home_connection() {
  # A deployed Pi can pin its intended home profile in the root-owned
  # EnvironmentFile. Falling back to the first saved profile preserves the
  # generic first-boot behavior for a newly provisioned device.
  if [ -n "${RAPID_HOME_CONNECTION:-}" ]; then
    printf '%s\n' "$RAPID_HOME_CONNECTION"
    return
  fi
  # The privileged onboarding service owns this fixed profile name. Prefer it
  # over unrelated historical wireless profiles without exposing its passphrase
  # to this controller or its state file.
  if nmcli -t -f NAME,TYPE connection show | awk -F: \
    '$1 == "rapid-home" && $2 == "802-11-wireless" { found=1 } END { exit !found }'; then
    printf '%s\n' rapid-home
    return
  fi
  nmcli -t -f NAME,TYPE connection show | awk -F: \
    '$2 == "802-11-wireless" && $1 != "'"$ap_connection"'" { print $1; exit }'
}

write_state() {
  mode=$1
  recovered_from=${2:-}
  temporary=$(mktemp "$runtime/.state.XXXXXX") || return 1
  if [ -n "$recovered_from" ]; then
    printf '{"mode":"%s","recovered_from":"%s","updated_at":"%s"}\n' \
      "$mode" "$recovered_from" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$temporary" || return 1
  else
    printf '{"mode":"%s","updated_at":"%s"}\n' \
      "$mode" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$temporary" || return 1
  fi
  chmod 0640 "$temporary" || return 1
  mv -f "$temporary" "$state"
}

activate() {
  target=$1
  wait_seconds=$2
  # apply_mode runs in a conditional, where shell errexit is disabled.
  # Propagate each failure explicitly before publishing a successful mode.
  [ -n "$target" ] || return 1
  nmcli radio wifi on || return 1
  nmcli -w "$wait_seconds" connection up "$target" ifname wlan0
}

apply_mode() {
  mode=$1
  case "$mode" in
    ap)
      activate "$ap_connection" 15 || return 1
      write_state ap
      ;;
    home)
      # Do not strand a keyboardless device after a bad password, missing
      # network, or failed NetworkManager activation. The dashboard starts
      # independently, while this bounded attempt restores the setup AP.
      if activate "$(home_connection)" 30; then
        write_state home
      elif activate "$ap_connection" 15; then
        write_state ap home
      else
        write_state unknown home
        return 1
      fi
      ;;
    off)
      nmcli radio wifi off || return 1
      write_state off
      ;;
    *) return 1 ;;
  esac
}

# A boot resumes the intended Home connection for at most 30 seconds, then
# starts the setup AP. Off is an explicit live choice and is reset by reboot.
if ! apply_mode home; then
  write_state unknown home
fi

while :; do
  if [ -f "$request" ]; then
    mode=$(sed -n 's/.*"mode"[[:space:]]*:[[:space:]]*"\(off\|ap\|home\)".*/\1/p' "$request" | head -n 1)
    action=$(sed -n 's/.*"action"[[:space:]]*:[[:space:]]*"\(restart-setup\)".*/\1/p' "$request" | head -n 1)
    rm -f "$request"
    if [ -n "$action" ]; then
      # The panel's settings page starts/restarts the local setup server so the
      # browser setup page becomes reachable again without a reboot. The panel
      # only writes the request file; this root worker owns the restart.
      systemctl restart rapid-setup.service || true
    fi
    if [ -n "$mode" ]; then
      if ! apply_mode "$mode"; then
        write_state error
      fi
    fi
  fi
  sleep 1
done
