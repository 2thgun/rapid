[Unit]
Description=raPId first-boot setup access point
Requires=rapid-firstboot.service
After=rapid-firstboot.service NetworkManager.service
Wants=NetworkManager.service
Before=rapid-setup.service rapid-network-mode.service

[Service]
Type=oneshot
User=root
Group=rapid
# Must match rapid-firstboot.service's RuntimeDirectory=rapid declaration
# exactly (owning group and mode): see the comment there (#25).
RuntimeDirectory=rapid
RuntimeDirectoryMode=0770
ExecStart=/usr/lib/rapid/rapid-provision --status-file /run/rapid/firstboot.json --ssid-file /run/rapid/network-ssid
RemainAfterExit=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
