[Unit]
Description=raPId first-boot setup access point
Requires=rapid-firstboot.service
After=rapid-firstboot.service NetworkManager.service
Wants=NetworkManager.service
Before=rapid-setup.service rapid-network-mode.service

[Service]
Type=oneshot
User=root
Group=rapid
# /run/rapid is owned by rapid-firstboot.service (RuntimeDirectory=rapid,
# Group=rapid, 0770); this unit must NOT declare it. A shared RuntimeDirectory
# is not reference counted, so stopping or restarting the provisioner would
# delete /run/rapid while rapid-setup.service and rapid.service still need it
# (#40, same class as #25). The Requires=/After=rapid-firstboot.service above
# plus this ReadWritePaths grant is the consumer side of that ownership.
ReadWritePaths=/run/rapid
ExecStart=/usr/lib/rapid/rapid-provision --status-file /run/rapid/firstboot.json --ssid-file /run/rapid/network-ssid
RemainAfterExit=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
