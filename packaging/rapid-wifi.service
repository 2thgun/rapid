[Unit]
Description=raPId constrained Wi-Fi application

[Service]
Type=oneshot
User=root
ExecStart=/usr/lib/rapid/rapid-wifi --request-file /run/rapid-apply/wifi-request.json --result-file /run/rapid-apply/wifi-result.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# #26: the passphrase now reaches NetworkManager as a private (0600) keyfile
# this service writes directly, so it needs write access to NetworkManager's
# connection directory. /run/rapid-apply is also required (pre-existing gap:
# ProtectSystem=strict otherwise leaves this service unable to write its own
# result file or delete its own request file; see COWORK.md, g2-sandbox #25).
ReadWritePaths=/etc/NetworkManager/system-connections /run/rapid-apply
