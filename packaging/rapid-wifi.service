[Unit]
Description=raPId constrained Wi-Fi application

[Service]
Type=oneshot
User=root
Group=rapid
# Shared request/result queue; systemd creates it before the mount namespace
# (#25). Must match rapid-setup/apply/account.service (Group=rapid, mode 0770).
RuntimeDirectory=rapid-apply
RuntimeDirectoryMode=0770
ExecStart=/usr/lib/rapid/rapid-wifi --request-file /run/rapid-apply/wifi-request.json --result-file /run/rapid-apply/wifi-result.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# #26: the passphrase now reaches NetworkManager as a private (0600) keyfile
# this service writes directly, so it needs write access to NetworkManager's
# connection directory. The request/result queue above is covered by
# RuntimeDirectory=rapid-apply, not a ReadWritePaths grant.
ReadWritePaths=/etc/NetworkManager/system-connections
