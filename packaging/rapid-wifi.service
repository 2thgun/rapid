[Unit]
Description=raPId constrained Wi-Fi application

[Service]
Type=oneshot
User=root
ExecStart=/usr/lib/rapid/rapid-wifi --request-file /run/rapid-apply/wifi-request.json --result-file /run/rapid-apply/wifi-result.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# ProtectSystem=strict makes /run read-only; the request/result queue lives here (#25).
ReadWritePaths=/run/rapid-apply
