[Unit]
Description=raPId constrained Wi-Fi application
# rapid-setup.service is the single lifecycle owner of the shared /run/rapid-apply
# request/result queue. A transient consumer must not declare RuntimeDirectory
# for it, or systemd removes the queue when the consumer stops even while
# rapid-setup is still active (#25). Ordering after the owner plus an explicit
# ReadWritePaths grant gives this unit the queue without owning it.
Requires=rapid-setup.service
After=rapid-setup.service

[Service]
Type=oneshot
User=root
Group=rapid
ExecStart=/usr/lib/rapid/rapid-wifi --request-file /run/rapid-apply/wifi-request.json --result-file /run/rapid-apply/wifi-result.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# #26: the passphrase now reaches NetworkManager as a private (0600) keyfile
# this service writes directly, so it needs write access to NetworkManager's
# connection directory. The request/result queue is owned by rapid-setup.service;
# this is the consumer-side ReadWritePaths grant for it (#25).
ReadWritePaths=/etc/NetworkManager/system-connections
ReadWritePaths=/run/rapid-apply
