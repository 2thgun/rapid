[Unit]
Description=raPId Qt touchscreen
Requires=rapid.service
After=rapid.service
Conflicts=getty@tty1.service display-manager.service

[Service]
User=rapid
Group=rapid
SupplementaryGroups=video input render
PAMName=login
WorkingDirectory=/var/lib/rapid
Environment=QT_QUICK_BACKEND=software
ExecStart=/usr/bin/xinit /usr/lib/rapid/rapid-panel -- /usr/lib/xorg/Xorg :0 vt1 -nolisten tcp
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
