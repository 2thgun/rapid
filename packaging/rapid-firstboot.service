[Unit]
Description=raPId first-boot state initialization
After=local-fs.target
Before=rapid-provision.service rapid-setup.service

[Service]
Type=oneshot
User=rapid
Group=rapid
StateDirectory=rapid-setup
StateDirectoryMode=0700
# /run/rapid is shared with rapid-provision.service (root) and rapid-setup.service
# (rapid), which both write new files into it (#25). Group=rapid plus 0770 here
# must match rapid-provision.service exactly: whichever unit starts first sets
# the directory's ownership and mode, and systemd re-applies them (recursively)
# on every later start that also declares this RuntimeDirectory name.
RuntimeDirectory=rapid
RuntimeDirectoryMode=0770
ExecStart=/usr/lib/rapid/rapid-firstboot --state-directory /var/lib/rapid-setup --status-file /run/rapid/firstboot.json --tls-certificate /var/lib/rapid-setup/device.crt --tls-private-key /var/lib/rapid-setup/device.key
RemainAfterExit=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
