[Unit]
Description=raPId first-boot state initialization
After=local-fs.target
Before=rapid-provision.service rapid-setup.service

[Service]
Type=oneshot
User=rapid
Group=rapid
StateDirectory=rapid-setup
StateDirectoryMode=0700
RuntimeDirectory=rapid
RuntimeDirectoryMode=0750
ExecStart=/usr/lib/rapid/rapid-firstboot --state-directory /var/lib/rapid-setup --status-file /run/rapid/firstboot.json --tls-certificate /var/lib/rapid-setup/device.crt --tls-private-key /var/lib/rapid-setup/device.key
RemainAfterExit=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
