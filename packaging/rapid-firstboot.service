[Unit]
Description=raPId first-boot state initialization
After=local-fs.target
Before=rapid-provision.service rapid-setup.service

[Service]
Type=oneshot
User=rapid
Group=rapid
StateDirectory=rapid-setup
StateDirectoryMode=0700
# /run/rapid holds the first-boot status, the setup-AP name and the
# pairing/calibration files. This unit is its single lifecycle owner: Group=rapid
# and mode 0770 make it usable by rapid-setup.service (rapid) and
# rapid-provision.service (root). A shared RuntimeDirectory is not reference
# counted - systemd removes it when ANY declaring unit stops - so a consumer
# declaring it deletes the directory out from under the others (#40, same class
# as #25). Only this unit declares RuntimeDirectory=rapid; consumers are ordered
# after it and use ReadWritePaths=/run/rapid. CheckPackage enforces this.
RuntimeDirectory=rapid
RuntimeDirectoryMode=0770
ExecStart=/usr/lib/rapid/rapid-firstboot --state-directory /var/lib/rapid-setup --status-file /run/rapid/firstboot.json --tls-certificate /var/lib/rapid-setup/device.crt --tls-private-key /var/lib/rapid-setup/device.key
RemainAfterExit=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
