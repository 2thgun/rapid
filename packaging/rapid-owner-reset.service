[Unit]
Description=raPId physical owner reset (clears the owner password, reissues the enrollment token)
# rapid-setup.service is the single lifecycle owner of the shared /run/rapid-apply
# request/result queue. This transient consumer must not declare RuntimeDirectory
# for it, or systemd removes the queue when the consumer stops even while
# rapid-setup is still active (#25). Ordering after the owner plus an explicit
# ReadWritePaths grant gives this unit the queue without owning it. Ordering
# after rapid-setup also orders after rapid-firstboot, which creates
# /var/lib/rapid-setup and owns /run/rapid.
Requires=rapid-setup.service
After=rapid-setup.service

[Service]
Type=oneshot
User=root
Group=rapid
# The panel (the physical trust boundary) drops a request file in the shared
# queue; this helper clears only the owner password hash and reissues the
# enrollment token. It never takes a password and never puts a secret in the
# result file.
ExecStart=/usr/lib/rapid/rapid-owner-reset --request-file /run/rapid-apply/owner-reset-request.json --result-file /run/rapid-apply/owner-reset-result.json --state-directory /var/lib/rapid-setup --status-file /run/rapid/firstboot.json
TimeoutStartSec=60
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The setup database and the enrollment token live in /var/lib/rapid-setup
# (created by rapid-firstboot); the rewritten first-boot status document is
# published under /run/rapid. All three grants are consumer-side: this unit
# owns none of those paths.
ReadWritePaths=/run/rapid-apply
ReadWritePaths=/var/lib/rapid-setup
ReadWritePaths=/run/rapid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
