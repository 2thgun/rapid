d /etc/rapid 0750 root rapid -
# /run/rapid-apply is deliberately NOT here: tmpfiles.d is only applied at boot
# and by the dpkg trigger, neither ordered against a service restart, so a
# missing directory made rapid-setup fail with 226/NAMESPACE. rapid-setup.service
# is the single lifecycle owner (RuntimeDirectory=rapid-apply, Group=rapid,
# 0770); rapid-apply/wifi/account.service are ordered after it and granted
# ReadWritePaths=/run/rapid-apply, so they never remove the queue.
